# Documentation only: the app reads process environment, not this file automatically.
PAYMENTSHIELD_PROVIDER=demo
PAYMENTSHIELD_DB=runtime/connector.sqlite3
# Only test keys are accepted. Never put secrets in frontend files or GitHub.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Required for merchant API calls. Choose a long random value locally.
PAYMENTSHIELD_MERCHANT_TOKEN=
# Independent PaymentShield live-risk service; no processor account required.
PAYMENTSHIELD_INTEGRATION_ID=my-app
PAYMENTSHIELD_INTEGRATION_SECRET=
PAYMENTSHIELD_LIVE_DB=runtime/live.sqlite3
